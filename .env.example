# Copiá este archivo como .env y completá los valores. En Render se cargan en "Environment".

# Base de datos: en Render alcanza con DATABASE_URL; en local se usan las DB_*
DATABASE_URL=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=envasadora

PORT=3000

# Contraseña para entrar a la app (obligatoria: sin ella la API rechaza todo)
APP_PASSWORD=

# Opcional: clave para firmar las sesiones. Si se omite se usa APP_PASSWORD.
# Generar una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# Opcional: sitios que pueden usar la API, separados por coma
CORS_ORIGINS=https://envasadora-frontend.vercel.app,http://localhost:3000

# Opcional: zona horaria para "hoy" y "este mes"
ZONA_HORARIA=America/Argentina/Buenos_Aires
